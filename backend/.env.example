# Copiá este archivo como `.env` y completá los valores. El archivo `.env` NO se sube a GitHub.
# En Render estas variables se cargan en el panel del servicio (Environment), no en un archivo.

# Cadena de conexión de PostgreSQL. En Neon: Dashboard -> Connect -> Connection string (con sslmode=require).
DATABASE_URL=postgresql://usuario:contraseña@host.neon.tech/tareaclara?sslmode=require

# Clave para firmar los tokens de sesión. Mínimo 32 caracteres en producción. Generala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiame-por-una-clave-larga-y-aleatoria

# Direcciones del frontend que pueden usar la API, separadas por coma (sin barra final).
CORS_ORIGINS=http://localhost:5173

# Opcionales
PORT=3000
# NODE_ENV=production
# TRUST_PROXY=1
